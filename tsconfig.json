{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["chrome"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/globals.d.ts"],
  "exclude": ["src/vendor/**"]
}
